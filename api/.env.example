# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blood_donation_db?schema=public"

# JWT
JWT_SECRET=change-this-super-secret-access-token-key
JWT_EXPIRES_IN=15m
REFRESH_SECRET=change-this-super-secret-refresh-token-key
REFRESH_EXPIRES_IN=7d

# Firebase Cloud Messaging (optional, ready for future integration)
FCM_SERVER_KEY=

# Matching
DEFAULT_RADIUS=50

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=20
